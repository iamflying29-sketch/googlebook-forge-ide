#!/bin/bash
# forge-ide: start, stop or inspect the Forge IDE server (a local Cursor-style AI coding IDE for Ollama).
#
#   forge-ide                 start in the foreground (Ctrl+C stops it)
#   forge-ide start|stop|restart|status|log    manage the background service (systemd user unit)
#   forge-ide open [FOLDER]   make FOLDER the folder a Forge window opens with
#   forge-ide model           rebuild the tuned "forge-coder" model from model/Modelfile
#   forge-ide bench           quick speed test of the model on this machine
#   forge-ide pair-reset      forget the Forge app's key (after reinstalling the app; the next app to open pairs)
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PORT="${FORGE_PORT:-8765}"
# Requests carry the VM key that the server keeps for Forge's own tools (only this user can read it).
KEYFILE="${FORGE_HOME:-$HOME/.forge-ide}/vm-key"
KEY_HEADER="X-Forge-Key: $(cat "$KEYFILE" 2>/dev/null)"
cmd="${1:-run}"
case "$cmd" in
  run)        shift || true; exec python3 -m forge --port "$PORT" "$@" ;;
  start)      systemctl --user start forge-ide.service && echo "Forge IDE started. Open the Forge app on the Googlebook." ;;
  stop)       systemctl --user stop forge-ide.service && echo "Forge IDE stopped" ;;
  restart)    systemctl --user restart forge-ide.service && echo "Forge IDE restarted. Reopen the Forge app's window if it shows the waiting screen." ;;
  status)     systemctl --user --no-pager status forge-ide.service || true
              echo; echo "Server port: $PORT (the Forge app connects to it)"; timeout 5 curl -s -H "$KEY_HEADER" "http://127.0.0.1:$PORT/api/status" | python3 -m json.tool 2>/dev/null || echo "(server not answering)" ;;
  log)        journalctl --user -u forge-ide.service -n "${2:-50}" --no-pager ;;
  open)       folder="${2:-$PWD}"; folder="$(cd "$folder" && pwd)"
              timeout 10 curl -s -X POST "http://127.0.0.1:$PORT/api/workspace" -H 'Content-Type: application/json' -H "$KEY_HEADER" \
                 -d "{\"path\": \"$folder\", \"create\": true}" >/dev/null && echo "Folder: $folder. A Forge window opened without a folder shows it." || echo "Server not running; start it with: forge-ide start" ;;
  model)      ( cd "$HERE/model" && timeout 600 ollama create forge-coder -f Modelfile ) ;;
  pair-reset) printf '{}\n' > "${FORGE_HOME:-$HOME/.forge-ide}/app-key.json" && echo "The server forgot the Forge app's key. Open the Forge app now; it pairs by itself." ;;
  bench)      timeout 900 python3 -I "$HERE/model/bench.py" "${2:-forge-coder}" ;;
  *)          sed -n '2,10p' "$0"; exit 1 ;;
esac
