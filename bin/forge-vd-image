#!/bin/bash
# forge-vd-image 17: builds Forge's Android 17 virtual device image (localhost/forge-android:17) from the WayDroid-ATV
# LineageOS 24.0 VANILLA system image and its MAINLINE vendor image. Both downloads are checked against their
# published SHA-256 sums. The images are only read (mounted read-only); the container image is the system tree with
# the vendor tree at /vendor and /etc as an empty folder, because the image's Docker-mode start step moves the files
# a container engine puts into /etc and then restores /etc as a link to /system/etc.
# Forge runs this inside a memory cap. Downloaded files are kept for a rebuild; nothing is deleted.
set -euo pipefail
VERSION=${1:-}
if [ "$VERSION" != 17 ]; then echo "Usage: forge-vd-image 17   (Android 11 to 16 are downloaded with podman pull)"; exit 2; fi
SYS=lineage-24.0-20260926-VANILLA-waydroid_x86_64-system.zip
SYS_SHA=182ef734924fd4295bcaeb3712e0fb5ac8ade454353d6910a43c2df7f7ac6203
VEN=lineage-24.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip
VEN_SHA=1085bfbc9606d5895fd871e472dad144c13a775ccd1666c898cd4ac107cbc8ba
BASE=$HOME/.forge-ide/vd/a17
DL=$BASE/dl-20261015; IMG=$BASE/img-20261015; STAGE=$BASE/stage; MNT=/mnt/forge-a17
CONF=$HOME/.forge-ide/vd/containers.conf
mkdir -p "$DL" "$IMG" "$STAGE/etc"
if [ "${FORCE:-0}" != 1 ] && sudo -n env CONTAINERS_CONF_OVERRIDE="$CONF" podman image exists localhost/forge-android:17; then
  echo "Android 17 is already built (FORCE=1 rebuilds it)."; exit 0
fi

fetch() {   # file folder sha256
  local f=$1 dir=$2 sum=$3
  if [ -f "$DL/$f" ] && echo "$sum  $DL/$f" | sha256sum -c --status -; then echo "Already downloaded and verified: $f"; return; fi
  echo "Downloading $f"
  for try in 1 2 3; do
    timeout 3600 curl -fL --retry 3 --retry-delay 5 -C - -sS -o "$DL/$f" \
      "https://sourceforge.net/projects/waydroid-atv/files/images/$dir/waydroid_x86_64/$f/download" && break
    echo "Retrying ($try)"; sleep 5
  done
  echo "$sum  $DL/$f" | sha256sum -c - || { echo "The checksum does not match, so the file is not used."; exit 1; }
}
fetch "$VEN" vendor "$VEN_SHA"
fetch "$SYS" system "$SYS_SHA"
echo "Unpacking"
[ -f "$IMG/vendor.img" ] || (cd "$IMG" && timeout 900 nice -n 10 unzip -o -q "$DL/$VEN")
[ -f "$IMG/system.img" ] || (cd "$IMG" && timeout 900 nice -n 10 unzip -o -q "$DL/$SYS")
sudo -n mkdir -p "$MNT/system" "$MNT/vendor"
mountpoint -q "$MNT/system" || sudo -n mount -o ro,loop "$IMG/system.img" "$MNT/system"
mountpoint -q "$MNT/vendor" || sudo -n mount -o ro,loop "$IMG/vendor.img" "$MNT/vendor"
trap 'sudo -n umount "$MNT/system" "$MNT/vendor" 2>/dev/null || true' EXIT
grep -q "^ro.system.build.version.sdk=37" <(sudo -n cat "$MNT/system/system/build.prop") || { echo "This is not an Android 17 (API 37) system image."; exit 1; }
echo "Building the container image"
sudo -n tar --xattrs --xattrs-include='*' -C "$MNT" -c vendor -C "$MNT/system" --exclude=./vendor --exclude=./etc . -C "$STAGE" etc \
  | sudo -n env CONTAINERS_CONF_OVERRIDE="$CONF" nice -n 10 podman import -c 'ENTRYPOINT ["/init"]' \
      -m "LineageOS 24.0 (Android 17) VANILLA 20260926 and MAINLINE vendor 20260927 from WayDroid-ATV, SHA-256 verified" \
      - localhost/forge-android:17
sync; sudo -n sysctl -q -w vm.drop_caches=1 || true
echo "Android 17 is ready."
