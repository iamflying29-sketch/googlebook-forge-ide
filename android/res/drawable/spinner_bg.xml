<?xml version="1.0" encoding="utf-8"?>
<!-- The closed spinner: a rounded dark field with a chevron on the right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg3" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="6dp" android:width="14dp" android:height="14dp" android:drawable="@drawable/ic_chevron_down" />
</layer-list>
