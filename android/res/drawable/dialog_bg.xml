<?xml version="1.0" encoding="utf-8"?>
<!-- Background of every dialog: a dark card with a thin border, inset like the system dialog. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="16dp" android:insetTop="16dp" android:insetRight="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/bg2" />
        <stroke android:width="1dp" android:color="@color/border2" />
        <corners android:radius="12dp" />
    </shape>
</inset>
