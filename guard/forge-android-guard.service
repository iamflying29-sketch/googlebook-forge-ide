[Unit]
Description=Forge Android guard: ends Android in a container the moment it starts to shut down, to protect the VM
After=systemd-journald.service
Before=waydroid-container.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/forge-guard/forge_android_guard.py
Restart=always
RestartSec=1
Nice=-5
MemoryMax=64M
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
