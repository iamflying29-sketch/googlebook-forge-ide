[Unit]
Description=Forge Android guard: protects the VM from Android in Forge's virtual devices (runs only while Forge runs)
After=systemd-journald.service systemd-sysctl.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/forge-guard/forge_android_guard.py
Restart=on-failure
RestartSec=1
Nice=-5
MemoryMax=128M
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
# Not started at boot: the Forge server starts it when Forge starts, and Quit Forge stops it.
