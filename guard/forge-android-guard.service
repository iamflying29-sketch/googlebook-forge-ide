[Unit]
Description=Forge Android guard: protects the VM from Android in containers (shutdowns, suspend, global settings)
After=systemd-journald.service systemd-sysctl.service
Before=waydroid-container.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/forge-guard/forge_android_guard.py
Restart=always
RestartSec=1
Nice=-5
MemoryMax=128M
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
